# .env.example (copiar a .env y modificar)
# ============================================
# BASE DE DATOS (PostgreSQL)
# ============================================
# Si usas Docker, estos valores deben coincidir con docker-compose.yml
DB_NAME=monitoreo_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ============================================
# REDIS (Para Celery)
# ============================================
# Si usas Docker, usa redis://redis:6379/0
# Si usas local, usa redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================
# DJANGO
# ============================================
DJANGO_SECRET_KEY=django-insecure-genera-tu-propia-clave-unica
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================
# TELEGRAM (Opcional - configurable desde interfaz)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# DOCKER
# ============================================
# Marcar que estamos en entorno Docker (se usa en settings.py)
DOCKER_ENV=0